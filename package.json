{
    "name": "dsh-status-rotator",
    "version": "0.17.1",
    "description": "Turn the DSH Web status line into a 1063-phrase meme machine: phase-aware phrases, typewriter, rainbow gradient, danmaku and 12 theme packs, all editable from the settings page.",
    "type": "module",
    "files": [
        "lib",
        "config.example.json",
        "gen-config.cjs",
        "cordis.patch.yml",
        "README.md",
        "README_ZH.md",
        "CHANGELOG.md",
        "CONTRIBUTORS.md",
        "CONTRIBUTORS_ZH.md",
        "LICENSE"
    ],
    "keywords": [
        "dsh",
        "deepseek-harness",
        "dsh-plugin",
        "plugin",
        "ui",
        "status",
        "status-label",
        "rotator",
        "typewriter",
        "rainbow",
        "weighted-random",
        "phrase-bank",
        "danmaku",
        "bilibili",
        "bullet-comment",
        "meme"
    ],
    "author": {
        "name": "01Virex",
        "url": "https://github.com/01Virex"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/01Virex/dsh-status-rotator.git"
    },
    "homepage": "https://github.com/01Virex/dsh-status-rotator#readme",
    "bugs": {
        "url": "https://github.com/01Virex/dsh-status-rotator/issues"
    },
    "main": "lib/index.js",
    "scripts": {
        "fetch-qq-group": "node scripts/fetch-qq-group.cjs",
        "test": "node scripts/smoke-test.cjs",
        "test:browser": "node scripts/run-danmaku-mount-test.cjs && node scripts/run-danmaku-mount-test.cjs --page=label",
        "test:browser:label": "node scripts/run-danmaku-mount-test.cjs --page=label"
    },
    "exports": {
        ".": "./lib/index.js",
        "./client": "./lib/client.js",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [],
            "immediately": true
        }
    },
    "license": "MIT"
}
