{
    "name":  "dsh-status-rotator",
    "version":  "0.3.0",
    "private":  true,
    "description":  "Rotates the DSH chat turn-status label (\"Deep diving...\") through user-defined phrases every few seconds, editable from DSH's settings panel.",
    "type":  "module",
    "main":  "lib/index.js",
    "scripts":  {
                    "fetch-qq-group":  "node scripts/fetch-qq-group.cjs"
                },
    "exports":  {
                    ".":  "./lib/index.js",
                    "./client":  "./lib/client.js",
                    "./package.json":  "./package.json"
                },
    "dsh":  {
                "bundle":  {
                               "patch":  "./cordis.patch.yml"
                           },
                "client":  {
                               "platform":  "web",
                               "inject":  [

                                           ],
                               "immediately":  true
                           }
            },
    "license":  "MIT"
}
