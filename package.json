{
    "name": "dsh-status-rotator",
    "version": "0.16.2",
    "description": "Turn the DSH status line into a 1059-phrase meme machine: typewriter, rainbow gradient, danmaku, 12 theme packs. Star it and your GitHub name joins the rotation.",
    "type": "module",
    "files": [
        "lib",
        "config.example.json",
        "cordis.patch.yml",
        "README.md",
        "README_ZH.md",
        "CONTRIBUTORS.md",
        "CONTRIBUTORS_ZH.md",
        "LICENSE"
    ],
    "keywords": [
        "dsh",
        "deepseek-harness",
        "dsh-plugin",
        "plugin",
        "ui",
        "status",
        "status-label",
        "rotator",
        "typewriter",
        "rainbow",
        "weighted-random",
        "phrase-bank",
        "danmaku",
        "bilibili",
        "bullet-comment",
        "meme"
    ],
    "author": {
        "name": "01Virex",
        "url": "https://github.com/01Virex"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/01Virex/dsh-status-rotator.git"
    },
    "homepage": "https://github.com/01Virex/dsh-status-rotator#readme",
    "bugs": {
        "url": "https://github.com/01Virex/dsh-status-rotator/issues"
    },
    "main": "lib/index.js",
    "scripts": {
        "fetch-qq-group": "node scripts/fetch-qq-group.cjs",
        "test": "node scripts/smoke-test.cjs"
    },
    "exports": {
        ".": "./lib/index.js",
        "./client": "./lib/client.js",
        "./package.json": "./package.json"
    },
    "dsh": {
        "bundle": {
            "patch": "./cordis.patch.yml"
        },
        "client": {
            "platform": "web",
            "inject": [],
            "immediately": true
